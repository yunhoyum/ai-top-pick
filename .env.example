# =====================================================================
# AI top-pick 환경변수 예시
# - 이 파일은 저장소에 올린다. 실제 값은 넣지 않는다.
# - PC1 구역은 pc1/.env 로, PC2 구역은 pc2/.env 로 복사해서 쓴다.
# - <PC1_IP>, <PC2_IP>, change-me 는 실제 값으로 바꾼다.
# - (제안) 표시는 설계 문서에 없는 값이다.
# =====================================================================


# =====================================================================
# [PC1] pc1/.env
# web, main-api, postgres, redis, celery-worker, celery-beat,
# embed-server, vision-server
# =====================================================================

# ---------- 호스트 공개 포트 (compose의 ports: 앞쪽 숫자) ----------
WEB_PORT=3000
MAIN_API_PORT=8000
POSTGRES_PORT=5432
EMBED_PORT=8001
VISION_PORT=8002
# redis, celery-worker, celery-beat 는 공개하지 않는다

# ---------- PostgreSQL (공식 이미지가 읽는 변수, 제안) ----------
POSTGRES_USER=aitoppick
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aitoppick

# ---------- DB·브로커 (같은 PC 안이라 서비스 이름으로 접근) ----------
# 드라이버 접두어(postgresql+asyncpg 등)는 ORM 드라이버를 정한 뒤 맞춘다
DATABASE_URL=postgresql://aitoppick:change-me@postgres:5432/aitoppick
REDIS_URL=redis://redis:6379/0

# ---------- 인증 ----------
JWT_SECRET=change-me
JWT_EXPIRE_MIN=60
# 두 PC가 반드시 같은 값이어야 한다
INTERNAL_TOKEN=change-me

# ---------- 외부 API (main-api만 보관, 아키텍처 7.1) ----------
DEEPGRAM_API_KEY=

# ---------- 서비스 주소 ----------
# PC2의 ai-service는 IP와 호스트 포트로 접근
AI_SERVICE_URL=http://<PC2_IP>:8000
# 같은 PC의 모델 서버는 서비스 이름과 컨테이너 포트로 접근 (worker용)
EMBED_URL=http://embed-server:8000
VISION_URL=http://vision-server:8000

# ---------- 파일 저장 (main-api, worker, vision-server가 같은 경로로 마운트, 제안) ----------
STORAGE_ROOT=/data/storage

# ---------- web (브라우저가 접근하는 main-api 주소) ----------
# Next.js는 NEXT_PUBLIC_ 변수를 빌드할 때 코드에 넣는다. 바꾸면 다시 빌드해야 한다
NEXT_PUBLIC_API_URL=http://<PC1_IP>:8000
NEXT_PUBLIC_WS_URL=ws://<PC1_IP>:8000

# ---------- CORS (코드베이스 4.5, 와일드카드 불가, 제안) ----------
CORS_ORIGINS=http://<PC1_IP>:3000

# ---------- vision-server (아키텍처 11.2) ----------
TF_FORCE_GPU_ALLOW_GROWTH=true


# =====================================================================
# [PC2] pc2/.env
# ai-service, llm-server, tts-server
# =====================================================================

# ---------- 호스트 공개 포트 ----------
AI_SERVICE_PORT=8000
# llm-server, tts-server 는 공개하지 않는다

# ---------- DB (PC1의 postgres에 IP로 접근, 아키텍처 4.1-3) ----------
DATABASE_URL=postgresql://aitoppick:change-me@<PC1_IP>:5432/aitoppick

# ---------- 인증 (PC1과 같은 값) ----------
INTERNAL_TOKEN=change-me

# ---------- PC1 모델 서버 (IP와 호스트 포트로 접근) ----------
EMBED_URL=http://<PC1_IP>:8001
VISION_URL=http://<PC1_IP>:8002

# ---------- PC2 모델 서버 (같은 PC 안이라 서비스 이름으로 접근) ----------
TTS_URL=http://tts-server:8000
# 서빙 도구가 미정이라 포트도 미정 (llama.cpp server 기본 8080, vLLM 기본 8000)
LLM_URL=http://llm-server:<미정>/v1
# 모델 미정
LLM_MODEL=
